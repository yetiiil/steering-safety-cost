# Copy to `.env` at the repository root and fill in. `.env` is gitignored.
#
# The Python entry points load this file with python-dotenv: train_cast.py,
# run_steering.py, run_benign.py, run_open_ended.py, generate_vectors.py,
# normalize_vectors.py, create_attack.py and evaluate_results.py.  run_utility.py
# inherits it by importing run_open_ended.  The shell scripts under scripts/ do
# not -- scripts/09_judge.sh checks OPENAI_API_KEY in its own environment before
# it starts python -- so export what a stage script needs as well.  See the
# README section "Credentials" for which mechanism applies where.

# Where HuggingFace model weights are cached. Leave empty for the HF default
# (~/.cache/huggingface). Read by train_cast.py.
HUGGINGFACE_CACHE_DIR=""

# Root the DIM refusal-direction pipeline writes to, and the sub-directory
# inside it.  Leave SAVE_DIR empty unless you need to write somewhere else, and
# then give an ABSOLUTE path.  cast.paths.dim_direction_dir() anchors a relative
# SAVE_DIR to the repository root, but the vendored
# third_party/refusal_direction/pipeline/config.py does not, and stage 3 runs
# after `cd third_party/refusal_direction`: a relative `SAVE_DIR=artifacts`
# would leave the direction inside the vendored tree, where no later stage looks
# for it.  Unset, both resolve to <repo>/artifacts/DIM/<model_id>/ -- the
# documented layout.
SAVE_DIR=""
DIM_DIR=DIM

# HuggingFace access token. Required for gated models (Llama-3.1) and by
# StrongREJECT's fine-tuned judge.
HF_TOKEN=""

# OpenAI key for the two GPT judges in evaluate_results.py. There is
# deliberately no command-line flag for it.  scripts/09_judge.sh reads it from
# the shell environment, not from here, so export it too if you use that script.
OPENAI_API_KEY=""

# Weights & Biases, optional. Leave WANDB_ENTITY empty to use your account
# default; run train_cast.py with --no_wandb (or WANDB_MODE=disabled) to skip
# W&B entirely.
WANDB_ENTITY=""
WANDB_PROJECT="cast"
